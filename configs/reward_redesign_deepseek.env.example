# Copy these non-secret settings into the run environment.
# Supply DEEPINFRA_API_KEY through your secret manager or shell; never commit it.
JUDGE_BACKEND=deepinfra
JUDGE_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
JUDGE_ENDPOINT=https://api.deepinfra.com/v1/chat/completions
JUDGE_CONFIDENCE_THRESHOLD=0.85
REQUIRE_FINISH=true
JUDGE_MAX_ANSWER_CHARS=6000
JUDGE_MAX_EVIDENCE_CHARS=8000
JUDGE_MAX_ANSWER_TO_GOLD_RATIO=3.0
JUDGE_CACHE_PATH=results/reward_judgments/deepseek_v41_flash_cache.json
